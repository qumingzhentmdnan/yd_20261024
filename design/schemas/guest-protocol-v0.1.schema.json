          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "params": {
          "$ref": "#/$defs/DetachTerminalParams"
        }
      },
      "required": [
        "requestID",
        "epoch",
        "connectionID",
        "method",
        "timeoutMs",
        "params"

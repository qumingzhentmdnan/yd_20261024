      "properties": {
        "requestID": {
          "$ref": "#/$defs/Sequence"
        },
        "epoch": {
          "$ref": "#/$defs/Epoch"
        },
        "connectionID": {
          "$ref": "#/$defs/UUID"
        },
        "method": {
          "const": "ResizeTerminal"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "params": {
          "$ref": "#/$defs/ResizeTerminalParams"

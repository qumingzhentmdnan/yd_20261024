        "requestID",
        "epoch",
        "connectionID",
        "method",
        "timeoutMs",
        "params"
      ],
      "additionalProperties": false
    },
    "Request": {
      "oneOf": [
        {
          "$ref": "#/$defs/HelloRequest"
        },
        {
          "$ref": "#/$defs/GetStateRequest"
        },
        {
          "$ref": "#/$defs/PrepareAgentRequest"
        },
        {
          "$ref": "#/$defs/StartSessionRequest"
        },
        {
          "$ref": "#/$defs/AttachTerminalRequest"
        },
        {
          "$ref": "#/$defs/ResizeTerminalRequest"
        },
        {
          "$ref": "#/$defs/DetachTerminalRequest"
        },
        {
          "$ref": "#/$defs/StopSessionRequest"
        }
      ]
    },
    "RequestEnvelope": {
      "type": "object",
      "properties": {
        "requestID": {
          "$ref": "#/$defs/Sequence"
        },
        "epoch": {
          "$ref": "#/$defs/Epoch"
        },
        "connectionID": {
          "$ref": "#/$defs/UUID"
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "params": {
          "type": "object"
        }

    },
    "DetachTerminalParams": {
      "type": "object",
      "properties": {
        "sessionID": {
          "$ref": "#/$defs/OpaqueID"
        },
        "streamID": {
          "$ref": "#/$defs/StreamID"
        }
      },
      "required": [
        "sessionID",
        "streamID"
      ],
      "additionalProperties": false
    },
    "DetachTerminalRequest": {
      "type": "object",
      "properties": {
        "requestID": {
          "$ref": "#/$defs/Sequence"
        },
        "epoch": {
          "$ref": "#/$defs/Epoch"
        },
        "connectionID": {
          "$ref": "#/$defs/UUID"
        },
        "method": {
          "const": "DetachTerminal"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "params": {
          "$ref": "#/$defs/DetachTerminalParams"
        }
      },
      "required": [
        "requestID",
        "epoch",
        "connectionID",
        "method",
        "timeoutMs",
        "params"
      ],
      "additionalProperties": false
    },
    "StopSessionParams": {
      "type": "object",
      "properties": {
        "sessionID": {
          "$ref": "#/$defs/OpaqueID"
        },
        "graceMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "forceAfterTimeout": {
          "type": "boolean"
        }
      },
      "required": [
        "sessionID",
        "graceMs",
        "forceAfterTimeout"
      ],
      "additionalProperties": false
    },
    "StopSessionRequest": {
      "type": "object",
      "properties": {
        "requestID": {
          "$ref": "#/$defs/Sequence"
        },
        "epoch": {
          "$ref": "#/$defs/Epoch"
        },
        "connectionID": {
          "$ref": "#/$defs/UUID"
        },
        "method": {
          "const": "StopSession"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "params": {
          "$ref": "#/$defs/StopSessionParams"
        }
      },

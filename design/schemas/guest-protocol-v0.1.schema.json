        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "params": {
          "$ref": "#/$defs/StopSessionParams"
        }
      },
      "required": [
        "requestID",
        "epoch",
        "connectionID",
        "method",
        "timeoutMs",
        "params"
      ],
      "additionalProperties": false
    },
    "Request": {
      "oneOf": [

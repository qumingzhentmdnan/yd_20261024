{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safeagent.invalid/design/guest-protocol-v0.1.schema.json",
  "title": "Guest 控制与终端 v0.1 候选负载契约",
  "description": "尚未冻结的生产目标；不声称当前 spike 完全符合。重复JSON键、UTF-8、帧长度、序号上界、状态与跨字段约束由文本规范补充。",
  "$defs": {
    "OpaqueID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$(?![\\s\\S])"
    },
    "VMRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$(?![\\s\\S])"
    },
    "Epoch": {
      "type": "string",
      "minLength": 1,
      "description": "原样使用 vm.VMInstance.Epoch，不要求 UUID；Guest 通道候选额外限定为1..128个Unicode字符，不修改VM生命周期契约。",
      "maxLength": 128
    },
    "UUID": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$(?![\\s\\S])"
    },
    "Nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
    },
    "Sequence": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$(?![\\s\\S])",
      "description": "另按无符号64位整数检查 <=18446744073709551615；十进制文本避免JSON数值精度丢失。"
    },
    "StreamID": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "Dimension": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "INVALID_ARGUMENT",
            "UNIMPLEMENTED",
            "FAILED_PRECONDITION",
            "STALE_INSTANCE",
            "CONFLICT",
            "NOT_FOUND",
            "RESOURCE_EXHAUSTED",
            "CANCELLED",
            "DEADLINE_EXCEEDED",
            "INTERNAL"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "Empty": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "Exit": {
      "type": "object",
      "properties": {
        "sessionID": {
          "$ref": "#/$defs/OpaqueID"
        },
        "code": {
          "type": "integer",
          "minimum": -1,
          "maximum": 255
        },
        "signal": {
          "type": "string",
          "pattern": "^(|SIG[A-Z0-9]+(\\+[0-9]+)?)$(?![\\s\\S])",
          "maxLength": 32,
          "description": "Linux符号信号名，例如SIGTERM/SIGKILL；实时信号使用SIGRTMIN+N；正常退出为空字符串。"
        },
        "reason": {
          "enum": [
            "process-exited",
            "stopped",
            "forced"
          ]
        }
      },
      "required": [
        "sessionID",
        "code",
        "signal",
        "reason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "signal": {
                "const": ""
              }
            }
          },
          "then": {
            "properties": {
              "code": {
                "minimum": 0
              }
            }
          },
          "else": {
            "properties": {
              "code": {
                "const": -1
              }
            }
          }
        }
      ]
    },
    "SessionInfo": {
      "type": "object",
      "properties": {
        "sessionID": {
          "$ref": "#/$defs/OpaqueID"
        },
        "preparedID": {
          "$ref": "#/$defs/OpaqueID"
        },
        "workspaceRef": {
          "$ref": "#/$defs/OpaqueID"
        },
        "workspaceDigest": {
          "$ref": "#/$defs/Digest"
        },
        "state": {
          "enum": [
            "running",
            "exited"
          ]
        },
        "groupState": {
          "enum": [
            "running",
            "empty",
            "unknown"
          ]
        },
        "exit": {
          "anyOf": [
            {
              "$ref": "#/$defs/Exit"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "sessionID",
        "preparedID",
        "workspaceRef",
        "workspaceDigest",
        "state",
        "groupState",
        "exit"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "running"
              }
            }
          },
          "then": {
            "properties": {
              "exit": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "exit": {
                "$ref": "#/$defs/Exit"
              }
            }
          }
        }
      ]
    },
    "Preparation": {
      "type": "object",
      "properties": {
        "preparedID": {
          "$ref": "#/$defs/OpaqueID"
        },
        "manifestRef": {
          "$ref": "#/$defs/OpaqueID"
        },
        "manifestDigest": {
          "$ref": "#/$defs/Digest"
        },
        "configDigest": {
          "$ref": "#/$defs/Digest"
        },
        "workspaceRef": {
          "$ref": "#/$defs/OpaqueID"
        },
        "workspaceDigest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "preparedID",
        "manifestRef",
        "manifestDigest",
        "configDigest",
        "workspaceRef",
        "workspaceDigest"
      ],
      "additionalProperties": false
    },
    "GuestState": {
      "type": "object",
      "properties": {
        "prepared": {
          "anyOf": [
            {
              "$ref": "#/$defs/Preparation"
            },
            {
              "type": "null"
            }
          ]
        },
        "sessions": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/SessionInfo"
          }
        },
        "currentSessionID": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpaqueID"
            },
            {
              "type": "null"
            }
          ]
        },
        "attachment": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttachmentInfo"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "prepared",
        "sessions",
        "currentSessionID",
        "attachment"
      ],
      "additionalProperties": false
    },
    "HelloParams": {
      "type": "object",
      "properties": {
        "vmRef": {
          "$ref": "#/$defs/VMRef"
        },
        "challenge": {
          "$ref": "#/$defs/Nonce"
        },
        "supportedVersions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "0.1"
          }
        }
      },
      "required": [
        "vmRef",
        "challenge",
        "supportedVersions"
      ],
      "additionalProperties": false
    },
    "HelloRequest": {
      "type": "object",
      "properties": {
        "requestID": {
          "$ref": "#/$defs/Sequence"
        },
        "epoch": {
          "$ref": "#/$defs/Epoch"
        },
        "connectionID": {
          "$ref": "#/$defs/UUID"
        },
        "method": {
          "const": "Hello"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "params": {
          "$ref": "#/$defs/HelloParams"
        }
      },
      "required": [
        "requestID",
        "epoch",
        "connectionID",
        "method",
        "timeoutMs",
        "params"
      ],
      "additionalProperties": false
    },
    "GetStateParams": {
      "$ref": "#/$defs/Empty"
    },
    "GetStateRequest": {
      "type": "object",
      "properties": {
        "requestID": {
          "$ref": "#/$defs/Sequence"
        },
        "epoch": {
          "$ref": "#/$defs/Epoch"
        },
        "connectionID": {
          "$ref": "#/$defs/UUID"
        },
        "method": {
          "const": "GetState"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "params": {
          "$ref": "#/$defs/GetStateParams"
        }
      },
      "required": [
        "requestID",
        "epoch",
        "connectionID",
        "method",
        "timeoutMs",
        "params"
      ],
      "additionalProperties": false
    },
    "PrepareAgentParams": {
      "type": "object",
      "properties": {
        "operationID": {
          "$ref": "#/$defs/UUID"
        },
        "manifestRef": {
          "$ref": "#/$defs/OpaqueID"
        },
        "manifestDigest": {
          "$ref": "#/$defs/Digest"
        },
        "configDigest": {
          "$ref": "#/$defs/Digest"
        },
        "workspaceRef": {
          "$ref": "#/$defs/OpaqueID"
        },
        "workspaceDigest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "operationID",
        "manifestRef",
        "manifestDigest",
        "configDigest",
        "workspaceRef",
        "workspaceDigest"
      ],
      "additionalProperties": false
    },
    "PrepareAgentRequest": {
      "type": "object",
      "properties": {
        "requestID": {
          "$ref": "#/$defs/Sequence"
        },
        "epoch": {
          "$ref": "#/$defs/Epoch"
        },
        "connectionID": {
          "$ref": "#/$defs/UUID"
        },
        "method": {
          "const": "PrepareAgent"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "params": {
          "$ref": "#/$defs/PrepareAgentParams"
        }
      },
      "required": [
        "requestID",
        "epoch",
        "connectionID",
        "method",
        "timeoutMs",
        "params"
      ],
      "additionalProperties": false
    },
    "StartSessionParams": {
      "type": "object",
      "properties": {
        "operationID": {
          "$ref": "#/$defs/UUID"
        },
        "sessionID": {
          "$ref": "#/$defs/OpaqueID"
        },
        "preparedID": {
          "$ref": "#/$defs/OpaqueID"
        },
        "workspaceRef": {
          "$ref": "#/$defs/OpaqueID"
        },
        "workspaceDigest": {
          "$ref": "#/$defs/Digest"
        },
        "rows": {
          "$ref": "#/$defs/Dimension"
        },
        "cols": {
          "$ref": "#/$defs/Dimension"
        }
      },
      "required": [
        "operationID",
        "sessionID",
        "preparedID",
        "workspaceRef",
        "workspaceDigest",
        "rows",
        "cols"
      ],
      "additionalProperties": false
    },
    "StartSessionRequest": {
      "type": "object",
      "properties": {
        "requestID": {
          "$ref": "#/$defs/Sequence"
        },
        "epoch": {
          "$ref": "#/$defs/Epoch"
        },
        "connectionID": {
          "$ref": "#/$defs/UUID"
        },
        "method": {
          "const": "StartSession"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "params": {
          "$ref": "#/$defs/StartSessionParams"
        }
      },
      "required": [
        "requestID",
        "epoch",
        "connectionID",
        "method",
        "timeoutMs",
        "params"
      ],
      "additionalProperties": false
    },
    "AttachTerminalParams": {
      "type": "object",
      "properties": {
        "sessionID": {
          "$ref": "#/$defs/OpaqueID"
        },
        "streamID": {
          "$ref": "#/$defs/StreamID"
        }
      },
      "required": [
        "sessionID",
        "streamID"
      ],
      "additionalProperties": false
    },
    "AttachTerminalRequest": {
      "type": "object",
      "properties": {
        "requestID": {
          "$ref": "#/$defs/Sequence"
        },
        "epoch": {
          "$ref": "#/$defs/Epoch"
        },
        "connectionID": {
          "$ref": "#/$defs/UUID"
        },
        "method": {
          "const": "AttachTerminal"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "params": {
          "$ref": "#/$defs/AttachTerminalParams"
        }
      },
      "required": [
        "requestID",
        "epoch",
        "connectionID",
        "method",
        "timeoutMs",
        "params"
      ],
      "additionalProperties": false
    },
    "ResizeTerminalParams": {
      "type": "object",
      "properties": {
        "sessionID": {
          "$ref": "#/$defs/OpaqueID"
        },
        "streamID": {
          "$ref": "#/$defs/StreamID"
        },
        "rows": {
          "$ref": "#/$defs/Dimension"
        },
        "cols": {
          "$ref": "#/$defs/Dimension"
        }
      },
      "required": [
        "sessionID",
        "streamID",
        "rows",
        "cols"
      ],
      "additionalProperties": false
    },
    "ResizeTerminalRequest": {
      "type": "object",
      "properties": {
        "requestID": {
          "$ref": "#/$defs/Sequence"
        },
        "epoch": {
          "$ref": "#/$defs/Epoch"
        },
        "connectionID": {
          "$ref": "#/$defs/UUID"
        },
        "method": {
          "const": "ResizeTerminal"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "params": {
          "$ref": "#/$defs/ResizeTerminalParams"
        }
      },
      "required": [
        "requestID",
        "epoch",
        "connectionID",
        "method",
        "timeoutMs",
        "params"
      ],

        "manifestDigest": {
          "$ref": "#/$defs/Digest"
        },
        "configDigest": {
          "$ref": "#/$defs/Digest"
        },
        "workspaceRef": {
          "$ref": "#/$defs/OpaqueID"
        },
        "workspaceDigest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "operationID",
        "manifestRef",
        "manifestDigest",
        "configDigest",
        "workspaceRef",
        "workspaceDigest"
      ],
      "additionalProperties": false
    },
    "PrepareAgentRequest": {
      "type": "object",
      "properties": {
        "requestID": {
          "$ref": "#/$defs/Sequence"
        },
        "epoch": {
          "$ref": "#/$defs/Epoch"
        },
        "connectionID": {
          "$ref": "#/$defs/UUID"
        },
        "method": {
          "const": "PrepareAgent"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "params": {
          "$ref": "#/$defs/PrepareAgentParams"
        }
      },
      "required": [
        "requestID",
        "epoch",
        "connectionID",
        "method",
        "timeoutMs",
        "params"
      ],
      "additionalProperties": false
    },
    "StartSessionParams": {
      "type": "object",
      "properties": {
        "operationID": {
          "$ref": "#/$defs/UUID"
        },
        "sessionID": {
          "$ref": "#/$defs/OpaqueID"
        },
        "preparedID": {
          "$ref": "#/$defs/OpaqueID"
        },
        "workspaceRef": {
          "$ref": "#/$defs/OpaqueID"
        },
        "workspaceDigest": {
          "$ref": "#/$defs/Digest"
        },
        "rows": {
          "$ref": "#/$defs/Dimension"
        },
        "cols": {
          "$ref": "#/$defs/Dimension"
        }
      },
      "required": [
        "operationID",
        "sessionID",
        "preparedID",
        "workspaceRef",
        "workspaceDigest",
        "rows",
        "cols"
      ],
      "additionalProperties": false
    },
    "StartSessionRequest": {
      "type": "object",
      "properties": {
        "requestID": {
          "$ref": "#/$defs/Sequence"
        },
        "epoch": {
          "$ref": "#/$defs/Epoch"
        },
        "connectionID": {
          "$ref": "#/$defs/UUID"
        },
        "method": {
          "const": "StartSession"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "params": {
          "$ref": "#/$defs/StartSessionParams"
        }
      },
      "required": [
        "requestID",
        "epoch",
        "connectionID",
        "method",
        "timeoutMs",
        "params"
      ],
      "additionalProperties": false
    },
    "AttachTerminalParams": {
      "type": "object",
      "properties": {
        "sessionID": {
          "$ref": "#/$defs/OpaqueID"
        },
        "streamID": {
          "$ref": "#/$defs/StreamID"
        }
      },
      "required": [
